# JARVIS environment template (E-023, runway R.2 — first Mac bootstrap).
# Copy to .env.local (gitignored). Every value is empty or loopback by default;
# JARVIS is fail-closed — leaving a var unset never enables anything.
# Census source: R.1 audit §7 + `grep -r "process.env\." src scripts` (2026-09-04).
# POSIX defaults live under ~/.jarvis/ ; Windows users keep their existing paths.

# ── Bootstrap posture (scripts/bootstrap-contract.ts; read by `npm run doctor`) ──
JARVIS_LOCAL_ONLY=true                       # keep every provider local; cloud stays gated
JARVIS_REAL_PROVIDERS_ENABLED=false          # real (non-mock) model providers
JARVIS_CLOUD_PROVIDERS_ENABLED=false         # cloud model providers (opt-in, budgeted)
JARVIS_ROOM_REAL_ADAPTERS_ENABLED=false      # real room/device adapters (observe_only default)
JARVIS_VOICE_REAL_PROVIDERS_ENABLED=false    # real STT/TTS providers
JARVIS_VISION_REAL_PROVIDERS_ENABLED=false   # real camera/vision providers (I3)
JARVIS_REMOTE_DASHBOARD_ENABLED=false        # non-loopback dashboard bind

# ── Bind / tools ──
JARVIS_BIND_HOST=127.0.0.1                   # loopback only; tools refuse a non-local bind
JARVIS_TOOLS_ENABLED=false                   # local tool surface (requires loopback bind)
# HOST=                                      # fallback bind host (JARVIS_BIND_HOST wins)
# HOSTNAME=                                  # fallback bind host

# ── Workspace / storage (all under process.cwd() unless overridden) ──
JARVIS_WORKSPACE_ROOT=                       # runtime-command workspace root (default ~/jarvis-workspace)
JARVIS_RUNTIME_WORKSPACE_ROOT=               # overrides JARVIS_WORKSPACE_ROOT for runtime commands
JARVIS_EVENT_DB_PATH=data/event-store.db     # Phase 11 event store (E-038); ROOM/COST/ACTIVITY read it; created on first chat
JARVIS_EVENT_STORE_ENABLED=true              # kill switch: false → nothing written, panels stay honestly synthetic
JARVIS_OBSERVABILITY_DB_PATH=                # sqlite observability store (LIVE when set)
JARVIS_CONSENT_MANIFEST_PATH=                # consent manifest override (default config/consent)

# ── Obsidian vault (two distinct vars — see R.1 §7) ──
JARVIS_OBSIDIAN_VAULT_ROOT=~/jarvis-vault    # WRITE root (memory/vault.ts); scaffolded on demand
OBSIDIAN_VAULT_PATH=                         # READ root for the pull-indexer (fail-closed when unset)
OBSIDIAN_EMBEDDING_MODEL=                    # semantic-retrieval embedding model id
OBSIDIAN_EMBEDDING_DIMENSION=                # embedding dimension
OBSIDIAN_EMBEDDING_TIMEOUT_MS=               # embedding call timeout
OBSIDIAN_SEMANTIC_QUERY=                     # ad-hoc query for `npm run obsidian:embed`

# ── Memory / embeddings (disabled by default) ──
JARVIS_MEMORY_EMBEDDINGS_ENABLED=false
JARVIS_MEMORY_EMBEDDING_PROVIDER=            # ollama | local fallback
JARVIS_MEMORY_EMBEDDING_MODEL=
JARVIS_MEMORY_EMBEDDING_DIMENSION=
JARVIS_MEMORY_EMBEDDING_FALLBACK_MODEL=      # default all-MiniLM-L6-v2
JARVIS_MEMORY_EMBEDDING_FALLBACK_DIMENSION=
JARVIS_MEMORY_EMBEDDING_TIMEOUT_MS=          # default 10000
JARVIS_MEMORY_VECTOR_STORE_ENABLED=false     # LanceDB vector store
JARVIS_MEMORY_VECTOR_STORE_PATH=             # default <cwd>/data/lancedb
JARVIS_MEMORY_VECTOR_STORE_TABLE=            # default memory_embeddings
JARVIS_MEMORY_VECTOR_STORE_DIMENSION=        # default 768
JARVIS_WORKING_MEMORY_ENABLED=false
JARVIS_WORKING_MEMORY_MAX_CHARS=             # default 12000
JARVIS_WORKING_MEMORY_MAX_RECENT_MESSAGES=
JARVIS_WORKING_MEMORY_MAX_RETRIEVED_MEMORIES=
JARVIS_SESSION_SUMMARY_ENABLED=true          # rolling session summary
JARVIS_SESSION_SUMMARY_EVERY_MESSAGES=       # default 10
JARVIS_PROJECT_MEMORY_BRIDGE_ENABLED=false   # WorkflowBox <-> memory bridge

# ── Local model runtime (Ollama, installed by 25D; E-037 chat provider) ──
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_VOICE_MODEL=qwen3.5:9b-mlx            # E-042: the brain for the live voice loop (think:false for a direct spoken answer)
JARVIS_DEFAULT_CHAT_PROVIDER=ollama          # kill switch: openai | anthropic | ollama (else JARVIS_LOCAL_ONLY=true → ollama)

# ── Cloud providers (all optional, all gated; never required for tests) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=                         # must be https
JARVIS_ENABLE_DEEPSEEK_LIVE=false            # local-dev override for the DeepSeek live smoke

# ── Voice: STT (faster-whisper via the repo venv — R.2 bootstrap) ──
JARVIS_STT_PROVIDER_ID=parakeet-mlx          # E-039: parakeet-mlx (default) | mlx-whisper | faster-whisper
JARVIS_STT_MLX_PYTHON_COMMAND=.venv-mlx/bin/python  # E-039 MLX venv (parakeet-mlx + mlx-whisper); falls back to JARVIS_STT_PYTHON_COMMAND
JARVIS_STT_PYTHON_COMMAND=.venv/bin/python   # faster-whisper venv (frozen fallback); created by `python3 -m venv .venv`
JARVIS_STT_EXECUTABLE=                       # alternative: a standalone STT executable
JARVIS_STT_MODEL_NAME=                       # e.g. base.en
JARVIS_STT_MODEL_PATH=                       # local model directory (no downloads at test time)
JARVIS_STT_LANGUAGE=en
JARVIS_STT_BEAM_SIZE=                        # default 5
JARVIS_STT_VAD_ENABLED=                      # default true
JARVIS_STT_TIMEOUT_MS=                       # default 30000
JARVIS_STT_MAX_AUDIO_BYTES=                  # default 25000000

# ── Voice: TTS (Piper terminal fallback; config/voice/piper-fallback.yaml holds Windows defaults — env wins per field) ──
JARVIS_TTS_PROVIDER_ID=
JARVIS_PIPER_EXECUTABLE=                     # POSIX: ~/.jarvis/runtimes/piper/piper (Phase 25D installs)
JARVIS_PIPER_MODEL=                          # POSIX: ~/.jarvis/runtimes/piper/voices/en_US-lessac-medium.onnx
JARVIS_PIPER_MODEL_CONFIG=                   # POSIX: ~/.jarvis/runtimes/piper/voices/en_US-lessac-medium.onnx.json
JARVIS_TTS_OUTPUT_DIR=                       # POSIX: ~/.jarvis/runtimes/piper/output
JARVIS_TTS_VOICE_ID=                         # default en_US-lessac-medium
JARVIS_TTS_TIMEOUT_MS=
JARVIS_TTS_MAX_INPUT_CHARS=
# ── TTS: mlx-audio (E-040, Phase 25D). ONE OpenAI-compatible server on :8004
#    serves kokoro (default), chatterbox-turbo (expressive) and qwen3-tts by
#    request model. Start it: scripts/voice/mlx-audio-server.sh ──
JARVIS_MLX_AUDIO_URL=http://127.0.0.1:8004    # kill switch: point elsewhere / empty
JARVIS_MLX_AUDIO_PORT=8004                    # server launch port
JARVIS_MLX_VENV=.venv-mlx                     # the MLX voice venv
JARVIS_CHATTERBOX_URL=http://127.0.0.1:8004  # legacy sidecar url (now the mlx-audio server)
# JARVIS_KOKORO_URL retired (E-040): the never-installed :8880 stanza; kokoro is served by mlx-audio on :8004

# ── Voice smokes (explicit local WAV refs; nothing runs without them) ──
JARVIS_PLAYBACK_SMOKE_AUDIO_REF=
JARVIS_PLAYBACK_SMOKE_DURATION_MS=
JARVIS_STT_SMOKE_AUDIO_REF=
JARVIS_STT_SMOKE_DURATION_MS=
JARVIS_FULL_LOOP_AUDIO_REF=
JARVIS_FULL_LOOP_DURATION_MS=

# ── Demo director export (`npm run demo:export`) ──
JARVIS_DEMO_BASE_URL=http://127.0.0.1:3000
JARVIS_DEMO_OUTPUT_ROOT=                     # default demo-exports
JARVIS_DEMO_CAPTURE_DWELL_MS=                # default 1100
JARVIS_DEMO_TTS_TIMEOUT_MS=                  # default 1500
JARVIS_DEMO_TIMESTAMP=                       # pin the export folder name

# ── Social / vision smokes ──
JARVIS_SOCIAL_SMOKE_URL=                     # allowlisted source URL for `npm run social:smoke`

# ── MCP gateway (Phase 24, frozen). Tokens are human-provisioned; only HASHES live here. ──
# JARVIS_MCP_TOKEN=                          # the CLIENT's presented token (never the server's)
# JARVIS_MCP_PROVISIONED_TOKEN_HASHES=       # comma-separated sha256 hashes of provisioned tokens
# JARVIS_MCP_CLIENT_REGISTRY=                # JSON {"<hash>":{"client_id":...,...}} — hashes + metadata only
JARVIS_STREAM_TEST_SECRET=                   # test-only stream secret; leave empty

# ── Google adapters (readiness/metadata only; no client secret in source — R.1 §7) ──
# GOOGLE_OAUTH_CLIENT_CONFIG_LOCATION=
# GOOGLE_OAUTH_TOKEN_LOCATION=
# GOOGLE_OAUTH_GRANTED_SCOPES=
# GOOGLE_OAUTH_CLIENT_CONFIG_PRESENT=
# GOOGLE_OAUTH_CLIENT_SECRET_METADATA_PRESENT=
# GOOGLE_OAUTH_TOKEN_METADATA_PRESENT=
# GOOGLE_OAUTH_ACCESS_TOKEN_METADATA_PRESENT=
# GOOGLE_OAUTH_REFRESH_TOKEN_METADATA_PRESENT=
# GOOGLE_OAUTH_AUTHORIZATION_METADATA_PRESENT=
# GOOGLE_OAUTH_CLIENT_ID_HASH=
# GOOGLE_OAUTH_TOKEN_REF_HASH=
# GOOGLE_OAUTH_TOKEN_EXPIRES_AT=
# GOOGLE_OAUTH_TOKEN_REVOKED_AT=
