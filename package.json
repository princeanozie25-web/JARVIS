{
  "name": "tempjarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dev:local": "next dev --hostname 127.0.0.1",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "doctor": "tsx scripts/doctor.ts",
    "obsidian:embed": "node --env-file=.env.local --import tsx scripts/obsidian-embed.ts",
    "obsidian:index": "node --env-file=.env.local --import tsx scripts/obsidian-index.ts",
    "knowledge:detect": "node --env-file=.env.local --import tsx scripts/knowledge-detect.ts",
    "wiki:draft": "node --env-file=.env.local --import tsx scripts/wiki-draft.ts",
    "google:readiness": "node --env-file=.env.local --import tsx scripts/google-readiness.ts",
    "morning:brief": "node --env-file=.env.local --import tsx scripts/morning-brief.ts",
    "smoke:model-runtime": "tsx scripts/model-runtime-smoke.ts",
    "smoke:model-runtime:stream": "tsx scripts/model-runtime-smoke.ts --stream",
    "smoke:deepseek": "node --env-file=.env.local --import tsx scripts/deepseek-smoke.ts",
    "social:smoke": "node --env-file=.env.local --import tsx scripts/social-extraction-smoke.ts",
    "voice:tts:smoke": "tsx scripts/voice/tts-smoke.ts",
    "voice:stt:smoke": "tsx scripts/voice/stt-smoke.ts",
    "voice:playback:smoke": "tsx scripts/voice/playback-smoke.ts",
    "voice:full-loop:smoke": "tsx scripts/voice/full-voice-loop-smoke.ts",
    "eval": "node --env-file=.env.local --import tsx scripts/run-eval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "better-sqlite3": "^12.10.0",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "maath": "^0.10.8",
    "next": "16.2.6",
    "openai": "^6.38.0",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sqlite-vec": "^0.1.9",
    "three": "^0.184.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json}": "prettier --write"
  }
}
