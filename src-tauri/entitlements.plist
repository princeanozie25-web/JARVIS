<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 25G (E-054) — entitlements applied to every binary Tauri signs in the
  bundle, including the Node sidecar. Node/V8 needs JIT + executable memory
  (without them the sidecar dies at start: "Failed to reserve virtual memory
  for CodeRange"), and it loads native addons (better-sqlite3) that carry no
  team signature. No network-server, camera, microphone or file entitlements
  are granted here: the shell owns none of those; the voice sidecars keep
  their own terminal-granted TCC permissions.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
